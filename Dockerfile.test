FROM python:3.15-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    UV_LINK_MODE=copy

WORKDIR /workspace

RUN apt-get update \
    && apt-get upgrade -y --no-install-recommends \
    && rm -rf /var/lib/apt/lists/* \
    && python -m pip install --no-cache-dir --upgrade pip uv setuptools msgpack urllib3

COPY pyproject.toml uv.lock README.md ./
COPY src ./src
COPY tests ./tests

RUN uv sync --locked --extra dev --no-editable \
    && rm -rf build sharedauth.egg-info

# pip 26.2.1 ainda embute urllib3/msgpack antigos. Atualiza as cópias que o
# próprio pip usa e sincroniza o BOM embutido, além das distribuições Python
# globais já atualizadas acima. A auditoria executa `pip` para enumerar pacotes.
RUN python - <<'PY'
import importlib.metadata
import json
import shutil
from pathlib import Path

global_site = Path("/usr/local/lib/python3.15/site-packages")
quality_site = Path("/workspace/.venv/lib/python3.15/site-packages")
versions = {
    name: importlib.metadata.version(name)
    for name in ("msgpack", "setuptools", "urllib3")
}

for vendor in (global_site / "pip/_vendor", quality_site / "pip/_vendor"):
    for name in ("msgpack", "urllib3"):
        source = global_site / name
        target = vendor / name
        shutil.rmtree(target, ignore_errors=True)
        shutil.copytree(source, target)

    bom_path = vendor / "bom.cdx.json"
    bom = json.loads(bom_path.read_text(encoding="utf-8"))
    replacements = {}
    for component in bom["components"]:
        name = component["name"].lower()
        if name not in versions:
            continue
        old_ref = component.get("bom-ref") or component.get("purl")
        new_ref = f"pkg:pypi/{name}@{versions[name]}"
        component["version"] = versions[name]
        component["purl"] = new_ref
        component["bom-ref"] = new_ref
        if old_ref:
            replacements[old_ref] = new_ref

    for dependency in bom["dependencies"]:
        if dependency.get("ref") in replacements:
            dependency["ref"] = replacements[dependency["ref"]]
        if "dependsOn" in dependency:
            dependency["dependsOn"] = [
                replacements.get(reference, reference)
                for reference in dependency["dependsOn"]
            ]
    bom_path.write_text(json.dumps(bom, indent=2) + "\n", encoding="utf-8")
PY
RUN rm -rf /root/.cache/uv

ENV PATH="/workspace/.venv/bin:$PATH"

CMD ["sh", "-ec", "ruff check . && pytest -q -p no:cacheprovider"]
